# --- Telegram ---
# Bot token from @BotFather. REQUIRED.
BOT_TOKEN=

# --- OpenAI ---
# API key used to generate the natural-language paid report. REQUIRED for paid reports.
OPENAI_API_KEY=
# Model used for report generation (kept configurable to control cost/quality).
OPENAI_MODEL=gpt-3.5-turbo
# Financial safety cap: max real OpenAI generation attempts per PAID analysis
# (successes + failures). Bounds worst-case AI spend on one already-paid
# analysis if generation keeps failing and the user keeps tapping "retry".
AI_MAX_GENERATION_ATTEMPTS_PER_ANALYSIS=5

# --- Payments ---
# Payment provider identifier: "mock" (default, no credentials needed, local
# testing only), "telegram" (native Telegram Payments), or "yookassa" (real
# YooKassa REST API integration).
PAYMENT_PROVIDER=mock

# Native Telegram Payments provider token (PAYMENT_PROVIDER=telegram only),
# issued by @BotFather -> Payments. Unrelated to YooKassa below.
PAYMENT_TOKEN=

# YooKassa (PAYMENT_PROVIDER=yookassa). These are the *shop* credentials —
# the merchant-facing API that actually charges the user for a report.
YOOKASSA_SHOP_ID=
YOOKASSA_SHOP_API_KEY=
# YooKassa *agent* credentials (a separate payouts API — sending money out).
# Not used by this MVP (there is no payout feature); accepted here only so
# they're available if a future feature needs them.
YOOKASSA_AGENT_ID=
YOOKASSA_AGENT_API_KEY=

# --- Database ---
# SQLite (default here) is for local development and the test suite only.
# PRODUCTION must use PostgreSQL — SQLite only allows one writer at a time
# and will raise "database is locked" under real concurrent Telegram
# traffic. See README "PostgreSQL (production)" for setup. Example:
#   DATABASE_URL=postgresql+asyncpg://lucky_num:password@localhost:5432/lucky_num
DATABASE_URL=sqlite+aiosqlite:///./lucky_num.db

# --- Product ---
# Price of the full report. A plain integer amount in RUB (rubles) — the
# server is always the source of truth for this value, never client input.
PRICE_RUB=99
CURRENCY=RUB

# --- Misc ---
LOG_LEVEL=INFO

# --- Leaderboard, promo codes, weekly automation ---
# Telegram user ID(s) allowed to open the admin panel (/admin). Comma-separated
# for several admins. Empty = no admin panel. Checked server-side on every action.
ADMIN_TELEGRAM_ID=
# Channel for the weekly TOP + public promo post: numeric chat ID
# (e.g. -1001234567890) or a public @channelname. The bot must be an admin of
# the channel. Empty = the post is skipped (recorded as "skipped").
PROMO_CHANNEL_ID=
# Timezone that defines a leaderboard week (Monday 00:00 - Sunday 23:59:59).
# A UTC offset such as +03:00 (Moscow) always works; IANA names like
# Europe/Moscow require the `tzdata` package on systems without a zone database.
APP_TIMEZONE=+03:00
# Local time (APP_TIMEZONE) on Monday when the weekly job runs, HH:MM.
WEEKLY_SCHEDULE_TIME=00:05
# Weekly public promo code: discount (1-99) and total activation limit.
WEEKLY_PROMO_DISCOUNT_PERCENT=25
WEEKLY_PROMO_MAX_ACTIVATIONS=100
# Personal one-time code for each of the weekly TOP-5 and how many days it stays valid.
TOP_REWARD_DISCOUNT_PERCENT=50
TOP_REWARD_VALID_DAYS=7
# Set to false to disable the in-process weekly scheduler (the admin panel can
# still run the same job manually).
WEEKLY_AUTOMATION_ENABLED=true
