# --- Telegram ---
# Bot token from @BotFather. REQUIRED.
BOT_TOKEN=

# --- OpenAI ---
# API key used to generate the natural-language paid report. REQUIRED for paid reports.
OPENAI_API_KEY=
# Model used for report generation (kept configurable to control cost/quality).
OPENAI_MODEL=gpt-4o-mini

# --- Payments ---
# Payment provider identifier. "mock" works out of the box for local testing.
# Set to "telegram" to use native Telegram Payments (requires PAYMENT_TOKEN from BotFather).
PAYMENT_PROVIDER=mock
# Provider token. Required for PAYMENT_PROVIDER=telegram (the payment provider token
# issued by @BotFather -> Payments). Not required for "mock".
PAYMENT_TOKEN=

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./lucky_num.db

# --- Product ---
# Price of the full report, in the smallest currency unit is NOT used here — this is
# a plain integer amount in RUB (rubles).
PRICE_RUB=99
CURRENCY=RUB

# --- Misc ---
LOG_LEVEL=INFO
